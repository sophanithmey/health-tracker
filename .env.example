# ============================================================================
# Family Diabetes Care — Environment Configuration Example
# Copy to .env.local and fill with your own credentials
# ============================================================================

# Supabase Database & Auth (Server & Client)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Telegram Family Caregiver Bot (Server-only — Never expose to browser)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# USDA FoodData Central API (Server-only — Never expose to browser)
# Obtain a free official API key at: https://fdc.nal.usda.gov/api-key-signup.html
# If left blank or unset, the system safely uses the official USDA 'DEMO_KEY' rate-limited fallback.
USDA_FOOD_DATA_CENTRAL_API_KEY="DEMO_KEY"
